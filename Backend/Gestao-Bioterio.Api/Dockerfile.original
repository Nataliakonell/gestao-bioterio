FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080
EXPOSE 8081


FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["Gestao-Bioterio.Api/Gestao-Bioterio.Api.csproj", "Gestao-Bioterio.Api/"]
COPY ["gestao-bioterio.Application/gestao-bioterio.Application.csproj", "gestao-bioterio.Application/"]
COPY ["gestao-bioterio.Domain/gestao-bioterio.Domain.csproj", "gestao-bioterio.Domain/"]
COPY ["Gestao-Bioterio.Persistence/Gestao-Bioterio.Persistence.csproj", "Gestao-Bioterio.Persistence/"]
COPY ["Gestao-Bioterio.Infra/gestao-bioterio.Infra.Infrastructure.csproj", "Gestao-Bioterio.Infra/"]
RUN dotnet restore "./Gestao-Bioterio.Api/Gestao-Bioterio.Api.csproj"
COPY . .
WORKDIR "/src/Gestao-Bioterio.Api"
RUN dotnet build "./Gestao-Bioterio.Api.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./Gestao-Bioterio.Api.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Gestao-Bioterio.Api.dll"]