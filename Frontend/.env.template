# ─── USADO APENAS POR npm run dev:initdata ───
# Popula o banco com dados de teste via chamadas à API.

# URL base da API (opcional, padrão http://localhost:5279)
API_URL=http://localhost:5279

# URL do servidor de autenticação (UCDB)
AUTH_URL=https://accounts.ucdb.br

# ── Opção 1: usuário/senha (recomendado) ──
# O username é o RA sem @ucdb.br
AUTH_USERNAME=seu-ra
AUTH_PASSWORD=sua-senha

# ── Opção 2: token direto (alternativa) ──
# AUTH_TOKEN=seu-token-aqui

//maquina ucdb
VITE_API_URL=/api